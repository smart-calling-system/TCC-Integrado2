# LOCAL: pode ser http://localhost:3000 ou http://localhost:3000/api/v1.
# O main.py normaliza automaticamente para terminar em /api/v1.
NODE_API_URL=http://localhost:3000/api/v1

# Use EXATAMENTE a mesma chave configurada em IA_API_KEY no backend Node.
# Gere/rotacione uma chave nova; não reutilize a chave que já foi exposta.
IA_API_KEY=COLOQUE_A_NOVA_CHAVE_AQUI

# O backend do Neil usa 0.85 por padrão.
NODE_MIN_FACE_SCORE=0.85
NODE_TIMEOUT_SEGUNDOS=10

# Reconhecimento facial
FACE_TOLERANCE=0.46
FACE_MARGIN=0.05
FACE_NUM_JITTERS=1

# Para Flutter Web/Vite em desenvolvimento. No APK não é necessário por CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
